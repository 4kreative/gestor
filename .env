# ============================================================
# GestorADS - Variaveis de ambiente
# Copie este arquivo para ".env" (sem o ".example") e preencha
# os valores. Se preferir, ignore esse arquivo e configure as
# mesmas variaveis direto no painel do Easypanel (aba Environment
# do servico) em vez de subir um .env dentro do zip.
# ============================================================

# BANCO DE DADOS (preencher com os dados do servico MySQL do Easypanel)
DB_HOST=gestorads-db
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# APLICACAO
APP_NAME=GestorPro
APP_URL=https://painel.seudominio.com.br
APP_ENV=production
# String aleatoria longa (32+ caracteres). Gere uma nova, nao reuse exemplos.
APP_SECRET=

# EVOLUTION API (WhatsApp)
EVOLUTION_API_URL=https://evo.seudominio.com.br
EVOLUTION_API_KEY=

# META ADS (opcional, se usar OAuth da Meta)
META_APP_ID=
META_APP_SECRET=

# GOOGLE ADS (opcional, se usar integracao Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=

# E-MAIL (opcional, para envio de notificacoes/reset de senha)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=GestorPro

# LOG DE ERROS (opcional, caminho customizado)
ERROR_LOG_PATH=
